# Copy to .env and fill in real values. .env is gitignored.

# --- HTTP (gateway) ---
HTTP_ADDR=:5050
HTTP_SHUTDOWN_TIMEOUT=30s
ALLOWED_ORIGINS=http://localhost:5050,null

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_TIMEOUT=10s
POSTGRES_PORT=5434

# --- Redis ---
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ADDR=localhost:6379

# --- Kafka (host-side listener) ---
KAFKA_PORT=29092
KAFKA_BROKERS=localhost:29092

# --- JWT (HS256 shared secret for the learning phase) ---
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- misc ---
LOGGER_LEVEL=DEBUG
TIME_ZONE=UTC
